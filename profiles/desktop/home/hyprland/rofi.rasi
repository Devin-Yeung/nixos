/* Start from rofi's own layout; style only the launcher and its popups. */
@theme "default"

* {
    background-color: transparent;
    text-color: #dde4f0;
    border-color: #ffffff20;
}

window {
    width: 700px;
    background-color: #161a22e6;
    border: 1px;
    border-radius: 18px;
    padding: 20px;
}

mainbox {
    spacing: 12px;
    border: 0px;
    padding: 0px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 12px 14px;
    background-color: #ffffff0d;
    border: 0px;
    border-radius: 10px;
}

prompt {
    text-color: #9db8e8;
}

entry {
    placeholder: "Search…";
    placeholder-color: #8a93a3;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    border: 0px;
    padding: 0px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    spacing: 12px;
    border: 0px;
    border-radius: 10px;
}

/* A quiet highlight instead of a solid accent block. */
element selected.normal,
element selected.active {
    background-color: #90b4ff2e;
    text-color: #ffffff;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

element-icon {
    size: 26px;
}

message {
    border: 0px;
    padding: 14px;
    background-color: #ffffff08;
    border-radius: 10px;
}

/* rofi's default theme scopes bare textboxes to its dark `foreground`
   (#002b36), which turns the cheat sheet's message window unreadable. */
textbox {
    text-color: #dde4f0;
}
