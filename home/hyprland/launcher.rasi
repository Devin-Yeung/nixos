/* Start from rofi's own layout; style only the launcher and its popups. */
@theme "default"

* {
    background-color: transparent;
    text-color: #eef2f8;
    border-color: #ffffff20;
}

window {
    width: 640px;
    background-color: #141820df;
    border: 1px;
    border-radius: 18px;
    padding: 18px;
}

mainbox {
    spacing: 12px;
    border: 0px;
    padding: 0px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 10px 12px;
    background-color: #ffffff0d;
    border: 0px;
    border-radius: 10px;
}

prompt {
    text-color: #90b4ff;
}

entry {
    placeholder: "Search…";
    placeholder-color: #a6afbd;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    border: 0px;
    padding: 0px;
    scrollbar: false;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border: 0px;
    border-radius: 10px;
}

element selected.normal,
element selected.active {
    background-color: #90b4ff;
    text-color: #141820;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

element-icon {
    size: 24px;
}

message {
    border: 0px;
    padding: 12px;
}

/* The keybinding cheat sheet uses aligned columns. */
textbox {
    font: "monospace 12";
}
